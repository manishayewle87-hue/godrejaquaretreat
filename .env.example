# 1. Base Canonical Domain (Must match your primary production custom domain)
NEXT_PUBLIC_SITE_URL=https://www.godrejparkworld.com

# 2. Google Search Console Site Verification Token
# (Retrieve from Google Search Console > Settings > Ownership Verification > HTML Tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=0wrEaGVPHBj6OBUSf4IwT6iOuQejVAt1WvxZgKIS7co

# 3. Google Analytics 4 (GA4) Measurement ID
# (Retrieve from Google Analytics > Admin > Data Streams > Measurement ID e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 4. Google Indexing API v3 Service Account Key (JSON String or File Path)
# Used by scripts/advanced-indexer.js to instantly publish URLs to Google
GOOGLE_SERVICE_ACCOUNT_KEY=

# 5. IndexNow Key (For instant indexing on Bing, Yandex, Seznam, Naver)
INDEXNOW_KEY=

# 6. Automated Lead Notification SMTP Credentials
# Submissions from /eoi and contact forms are dispatched to propsmartrealty@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=propsmartrealty@gmail.com
SMTP_PASS=
NOTIFICATION_EMAIL=propsmartrealty@gmail.com
